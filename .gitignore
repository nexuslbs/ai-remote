# --- non-versioned, machine-local config (the whole point of this repo) ---
config/host.env
config/key.path
# the private key itself lives here and is used in place by ssh
config/id_ed25519*
config/id_ecdsa*
config/id_rsa*
config/*.pem
config/*.key
config/*.ppk

# --- never commit key material of any kind ---
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.ssh/
**/known_hosts

# --- generated state ---
*.code-workspace.local
.vscode/settings.local.json
.env
.env.*
!.env.example

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# --- language junk (in case someone runs things here) ---
__pycache__/
*.py[cod]
.venv/
node_modules/
