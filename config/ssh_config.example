# Copy to config/ssh_config  (git-ignored), then replace the three <...> values.
#
# This file lives INSIDE the project and is the entire connection definition:
# address, user, port, key path. Nothing is written to ~/.ssh - the private key
# stays next to this file (config/id_ed25519, git-ignored) and is read IN PLACE,
# and the host keys ssh learns are kept in config/known_hosts, also inside the
# project.
#
# VS Code's Remote-SSH extension cannot take this file's path from a workspace
# file (that setting is machine-scoped, see README -> "The one line VS Code
# forces"), so one single pointer to this file exists outside the folder:
#   - User setting : "remote.SSH.configFile": "C:/Users/<you>/ai-remote/config/ssh_config"
#   - or one line at the TOP of ~/.ssh/config:
#       Include C:/Users/<you>/ai-remote/config/ssh_config
# Use one, not both. Nothing else leaves the project.
#
# No script to run. Open ai-remote.code-workspace afterwards.
# Paths: use forward slashes, even on Windows. The alias must stay "nexus-ai"
# unless you also edit ai-remote.code-workspace.

Host nexus-ai
    HostName 203.0.113.10
    User root
    Port 22
    IdentityFile "C:/Users/<you>/ai-remote/config/id_ed25519"
    UserKnownHostsFile "C:/Users/<you>/ai-remote/config/known_hosts"
    IdentitiesOnly yes
    PreferredAuthentications publickey
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes
    ForwardAgent no
    Compression no
