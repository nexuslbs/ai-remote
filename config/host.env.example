# Copy to config/host.env (git-ignored) and fill in YOUR values.
#
# The real machine IP is NEVER committed to this public repo.
# Nothing in config/host.env is a credential - it is an address.
# The private key path lives in config/key.path (also git-ignored).
#
# NEXUS_SSH_HOST   machine IP or DNS name reachable over SSH
# NEXUS_SSH_USER   login user (must own /opt/workspace/ai on that machine)
# NEXUS_SSH_PORT   sshd port
# NEXUS_ALIAS      the Host alias used by the .code-workspace (keep "nexus-ai"
#                  unless you also edit ai-remote.code-workspace)
# NEXUS_REMOTE_PATH default folder opened inside VS Code (informational;
#                  the .code-workspace carries it)

NEXUS_SSH_HOST=203.0.113.10
NEXUS_SSH_USER=root
NEXUS_SSH_PORT=22
NEXUS_ALIAS=nexus-ai
NEXUS_REMOTE_PATH=/opt/workspace/ai
