{
  // Everything that defines the connection lives in this folder: config/ssh_config
  // (host, user, port, key path) plus config/id_ed25519 (the key, read in place).
  //
  // No remote.SSH.* setting here on purpose - it is machine-scoped, so VS Code
  // ignores it in a workspace file and the remote folder then fails to resolve
  // ("ENOPRO: No filesystem provider found"). The single pointer VS Code needs is
  // a User setting ("remote.SSH.configFile" -> config/ssh_config) or one Include
  // line in ~/.ssh/config. See README -> "The one line VS Code forces".
  "folders": [
    {
      "name": "ai (remote)",
      "uri": "vscode-remote://ssh-remote+nexus-ai/opt/workspace/ai"
    }
  ],
  "settings": {
    "git.openRepositoryInParentFolders": "always",
    "files.watcherExclude": {
      "**/results/**": true,
      "**/.git/objects/**": true
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.defaultInterpreterPath": "/usr/bin/python3"
  }
}
