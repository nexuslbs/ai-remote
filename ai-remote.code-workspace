{
  // Nothing remote.SSH.* in here on purpose: VS Code resolves the folder URIs below
  // BEFORE the workspace's own settings exist, so a config path set here is never used
  // and the remote folder fails with "ENOPRO: No filesystem provider found".
  // Put the ssh config path in your USER settings, or Include the stanza from
  // ~/.ssh/config. See README -> Troubleshooting.
  "folders": [
    {
      "name": "ai (remote)",
      "uri": "vscode-remote://ssh-remote+nexus-ai/opt/workspace/ai"
    }
  ],
  "settings": {
    "git.openRepositoryInParentFolders": "always",
    "files.watcherExclude": {
      "**/results/**": true,
      "**/.git/objects/**": true
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.defaultInterpreterPath": "/usr/bin/python3"
  }
}
